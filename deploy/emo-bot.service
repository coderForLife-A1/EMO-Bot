# systemd unit for the EMO-Bot runtime. Install: see RUNNING.md, section 9.
# Change User= and the /home/pi/EMO-Bot paths if your setup differs.
[Unit]
Description=EMO-Bot desk robot runtime
After=network-online.target mosquitto.service sound.target
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/EMO-Bot
ExecStart=/home/pi/EMO-Bot/.venv/bin/python main.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
