# Copy to .env and fill in. Empty values fall back to the defaults shown in config.py.

# --- Cloud APIs ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
PORCUPINE_ACCESS_KEY=
# Custom wake word (.ppn from Picovoice console); empty = built-in "porcupine"
PORCUPINE_KEYWORD_PATH=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_TTS_URL=https://api.elevenlabs.io/v1/text-to-speech
WHISPER_MODEL=whisper-1
# Spoken language (en, hi, ta, ...); auto = let Whisper guess (unreliable on short clips)
WHISPER_LANGUAGE=en
# Vocabulary hint so Whisper spells names right; off = none
WHISPER_PROMPT=EMO is a small desktop robot. The user is talking to EMO.
# Cloud reply model: used when LOCAL_LLM_URL is empty, or as the fallback when the laptop can't answer
CHAT_MODEL=gpt-4o
# Gemini answers typed questions on the console (text only, no voice needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Budget in seconds for Whisper -> LLM (all tiers) -> TTS (playback not included)
API_TIMEOUT_SECONDS=15

# --- Laptop LLM (Ollama) ---
# http://<laptop-ip>:11434 on the shared network (private IP or <name>.local only); empty = cloud CHAT_MODEL only
LOCAL_LLM_URL=
# Non-thinking model only (thinking models reason out loud and take ~10 s)
LOCAL_LLM_MODEL=gemma4:e4b
# Second local model when LOCAL_LLM_MODEL is unsure; off = ask CHAT_MODEL (cloud) instead.
# Only if both fit in GPU memory together (e.g. LOCAL_LLM_MODEL=gemma3:4b + gemma4:e4b on a bigger GPU)
LOCAL_LLM_ESCALATE_MODEL=off
# Seconds: to connect (unreachable laptop -> cloud), and longest wait for the next piece of a reply
LOCAL_LLM_CONNECT_TIMEOUT=1
LOCAL_LLM_TIMEOUT=5
# How long Ollama keeps the model loaded after a reply
LOCAL_LLM_KEEP_ALIVE=30m
# Context window in tokens (small = the model fits in GPU memory)
LOCAL_LLM_CONTEXT=4096
# Told to the model with the date and time, e.g. Chennai, India; empty = not mentioned
ROBOT_LOCATION=
# Reply tuning (laptop and cloud): lower temperature = fewer made-up facts
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=150
# Follow-up questions: remember this many exchanges (0 = off), forgotten after this many quiet seconds
CONVERSATION_TURNS=3
CONVERSATION_MEMORY_SECONDS=120
# 1 = log what the user said and the reply at INFO (ends up in the system journal)
LOG_CONVERSATIONS=0

# --- Hardware ---
# /dev/serial0 (Pi GPIO UART: the ESP32 default), /dev/ttyUSB0 (Nano, or ESP32 with LINK_UART2 0, over USB), or "sim" (no controller: log commands)
SERIAL_PORT=/dev/serial0
SERIAL_BAUD=115200
# auto (the USB webcam, found automatically), picamera2 (Pi CSI camera), /dev/video0, or 0 (first webcam on a laptop)
CAMERA_SOURCE=auto
# "console" = the laptop console's webcam (switch it on with the page's Camera button)
# Talk button records: robot (the Pi's mic, e.g. the USB webcam's) or console (the laptop's, in the browser)
MIC_SOURCE=robot
# Microphone name substring or index from `python robot_mic.py`; empty = the USB/webcam mic, found automatically
AUDIO_INPUT_DEVICE=
# ALSA playback device for aplay (e.g. plughw:0); empty = default
AUDIO_OUTPUT_DEVICE=
# Mic level that counts as speech after the wake word (RMS, 16-bit). The log's "loudest RMS" helps tune it
SPEECH_RMS_THRESHOLD=500

# Where the robot's voice plays: auto (the laptop console while one is open, else aplay), console, local
AUDIO_OUTPUT=auto

# --- Laptop console (face, mic, speaker in a browser; see RUNNING.md section 9b) ---
ENABLE_CONSOLE=1
# 127.0.0.1 = reach it through an SSH tunnel: ssh -L 8080:localhost:8080 <user>@<pi>, then http://localhost:8080
# 0.0.0.0 = open to the network: needs CONSOLE_TOKEN, and HTTPS (CONSOLE_CERT/KEY) for the mic
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8080
# Long random secret, e.g. `openssl rand -hex 16`; open the console as https://<pi>:8080/?token=<token>
CONSOLE_TOKEN=
# From tools/make_console_cert.sh (self-signed; the browser asks you to accept it once)
CONSOLE_CERT=
CONSOLE_KEY=

# --- Subsystems (1/0) ---
ENABLE_VISION=1
ENABLE_AUDIO=1
# Face detection (off: nothing uses it yet, and it costs CPU on the Pi)
FACE_DETECTION=0
# Allow standing/walking when the Nano booted without an IMU (no balance or fall detection). Bench tests only.
ALLOW_NO_IMU=0
# Start with the servos off until "stand" (console button or robot/locomotion/cmd): bench tests
START_RESTING=0
# ToF distance poll period in seconds (0 = only on request); slower while the sensor is missing
DISTANCE_POLL_S=0.5
DISTANCE_BACKOFF_S=10
# Sensor calibration from tools/calibrate_sensors.py; empty = calibration.json in the repo
CALIBRATION_FILE=

# --- MQTT ---
# Anyone who can reach the broker can drive the robot: keep it on localhost, or use a login + TLS
MQTT_HOST=127.0.0.1
# Empty = 1883, or 8883 when MQTT_TLS=1
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
# 1 = connect with TLS; MQTT_CA_CERTS = CA file for a self-signed broker certificate (empty = system CAs)
MQTT_TLS=0
MQTT_CA_CERTS=
